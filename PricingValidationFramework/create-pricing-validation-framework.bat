@echo off
setlocal

rem ===========================================================================
rem create-pricing-validation-framework.bat
rem
rem Recreates the PricingValidationFramework solution (Core, DataLoader,
rem Tests, config/radar routing, docs, pipeline YAMLs, sample data) from the
rem loader-values-batches-update branch (commit 2dd63e1 plus the uncommitted
rem seed command, Radar compare-only, and ICE-stage changes), with no git and
rem no network access to the repo.
rem
rem Works WITHOUT admin rights:
rem   - writes only to the folder you run it from and to %TEMP%
rem   - installs nothing, changes no system settings, needs no elevation
rem   - decodes with certutil (falls back to PowerShell) and extracts with
rem     tar (falls back to PowerShell Expand-Archive), all built into Windows
rem
rem Building needs the .NET 10 SDK. If it isn't installed, the files are
rem still extracted and the script explains how to get the SDK without admin.
rem
rem Usage:  create-pricing-validation-framework.bat [target-folder]
rem         default target folder: PricingValidationFramework
rem ===========================================================================

set "scriptname=%~nx0"
cd /d "%~dp0"

set "targetdir=%~1"
if "%targetdir%"=="" set "targetdir=PricingValidationFramework"

if exist "%targetdir%" (
    echo Target folder "%targetdir%" already exists - refusing to overwrite it.
    echo Delete or rename it first, or pass a different folder name:
    echo   create-pricing-validation-framework.bat ^<folder-name^>
    goto :fail
)

rem Long paths: enabling Windows long-path support needs admin, so keep the
rem base folder short. Build output adds about 50 characters to the longest
rem source path, which is about 120 characters below the target folder.
for %%I in ("%targetdir%") do set "fullpath=%%~fI"
set "probe=%fullpath:~85,1%"
if defined probe (
    echo WARNING: "%fullpath%" is a long path.
    echo Builds can fail on Windows' 260-character path limit, which needs admin to lift.
    echo If the build fails with "path too long", move this script somewhere shorter,
    echo for example %USERPROFILE%\src, and run it again.
    echo.
)

set "b64file=%TEMP%\pvf-%RANDOM%%RANDOM%.b64"
set "zipfile=%TEMP%\pvf-%RANDOM%%RANDOM%.zip"

echo Writing embedded archive...
