echo   Seed first baselines into [Xml].[Response] for scenarios without one. Copy
echo   data\import\examples\local-settings.example.json to data\import\local-settings.json,
echo   fill it in, then:
echo     dotnet run --project PricingValidationFramework.DataLoader -- seed --settings data\import\local-settings.json --max-parallel 1
echo.
echo   VS Code: open the "%targetdir%" folder; Run and Debug lists
echo   1. validate, 2. import and 3. seed, all using that settings file.
echo.
echo   Radar routing lives in config\radar\mappings.json and config\radar\XPathProfiles.
