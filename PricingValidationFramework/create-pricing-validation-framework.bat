echo bG9jYWwtc2V0dGluZ3MuZXhhbXBsZS5qc29uUEsBAhQDFAAAAAgAAABNXWtdfWNxAAAAqgAAACEA
echo AAAAAAAAAAAAAKQBSmQCAGRhdGEvaW1wb3J0L2V4YW1wbGVzL3JlcXVlc3RzLmNzdlBLBQYAAAAA
echo gACAAPU0AAD6ZAIAAAA=
) > "%b64file%"

echo Decoding archive...
certutil -decode "%b64file%" "%zipfile%" >nul 2>nul
if errorlevel 1 (
    echo certutil is unavailable or blocked - trying PowerShell instead...
    if exist "%zipfile%" del "%zipfile%" >nul 2>nul
    powershell -NoProfile -Command "[IO.File]::WriteAllBytes($env:zipfile, [Convert]::FromBase64String([IO.File]::ReadAllText($env:b64file)))"
)
del "%b64file%" >nul 2>nul
if not exist "%zipfile%" (
    echo Could not decode the embedded archive with certutil or PowerShell.
    goto :fail
)

rem Integrity check: the decoded archive must match the fingerprint recorded when this
rem script was generated. A copy that lost or changed any line (e.g. through copy and
rem paste) is stopped here, before anything is extracted.
set "expectedhash=BD51CD7AFA67F580564002B495481F0ADAF3998EB34A5E1731494ED402D210C3"
set "actualhash="
for /f "skip=1 delims=" %%H in ('certutil -hashfile "%zipfile%" SHA256 2^>nul') do if not defined actualhash set "actualhash=%%H"
rem certutil prints "CertUtil: ..." when it fails; ignore that so PowerShell is tried instead.
if defined actualhash if not "%actualhash:CertUtil=%"=="%actualhash%" set "actualhash="
if not defined actualhash for /f "delims=" %%H in ('powershell -NoProfile -Command "(Get-FileHash -Algorithm SHA256 -LiteralPath $env:zipfile).Hash"') do set "actualhash=%%H"
if defined actualhash set "actualhash=%actualhash: =%"
if /i not "%actualhash%"=="%expectedhash%" goto :damaged
echo Archive checksum OK.

echo Extracting to "%targetdir%"...
mkdir "%targetdir%"
tar -xf "%zipfile%" -C "%targetdir%" 2>nul
if errorlevel 1 (
    echo tar is unavailable or failed - trying PowerShell instead...
    powershell -NoProfile -Command "Expand-Archive -LiteralPath $env:zipfile -DestinationPath $env:targetdir -Force"
)
del "%zipfile%" >nul 2>nul

if not exist "%targetdir%\PricingValidationFramework.slnx" (
    echo Extraction did not produce the expected files in "%targetdir%".
    goto :fail
)

echo.
echo Project extracted to "%fullpath%".
echo.

rem Find the .NET SDK: on PATH, or a per-user install that needed no admin.
set "dotnetexe="
for /f "delims=" %%D in ('where dotnet 2^>nul') do if not defined dotnetexe set "dotnetexe=%%D"
if not defined dotnetexe if exist "%LOCALAPPDATA%\Microsoft\dotnet\dotnet.exe" set "dotnetexe=%LOCALAPPDATA%\Microsoft\dotnet\dotnet.exe"
if not defined dotnetexe if exist "%USERPROFILE%\.dotnet\dotnet.exe" set "dotnetexe=%USERPROFILE%\.dotnet\dotnet.exe"

if not defined dotnetexe goto :nosdk
"%dotnetexe%" --list-sdks 2>nul | findstr /b "10." >nul
if errorlevel 1 goto :nosdk

echo Building with "%dotnetexe%"...
echo NuGet packages are downloaded to your user profile on the first build,
echo so this needs access to nuget.org or your company's package feed.
echo.
pushd "%targetdir%"
"%dotnetexe%" build PricingValidationFramework.slnx
set "buildresult=%errorlevel%"
popd
echo.
if not "%buildresult%"=="0" (
    echo The build failed - see the errors above. The source files are all in place.
    echo Common causes on locked-down machines: no access to nuget.org - ask for
    echo your company's NuGet feed - or the 260-character path limit.
    echo.
)
goto :nextsteps

:nosdk
echo The .NET 10 SDK was not found, so nothing was built. The source files are all in place.
echo.
echo To get it without admin rights, ask IT for the SDK, or install it into your user profile:
echo   1. Download dotnet-install.ps1 from https://dot.net/v1/dotnet-install.ps1
echo   2. powershell -NoProfile -ExecutionPolicy Bypass -File dotnet-install.ps1 -Channel 10.0
echo      This installs to %%LOCALAPPDATA%%\Microsoft\dotnet. Check your company's policy first.
echo   3. Run this script again in a new folder, or build manually:
echo      cd %targetdir%
echo      "%%LOCALAPPDATA%%\Microsoft\dotnet\dotnet.exe" build PricingValidationFramework.slnx
echo.

:nextsteps
echo Next steps, from the "%targetdir%" folder:
echo.
echo   Run the unit and system tests:
echo     dotnet test PricingValidationFramework.Tests\PricingValidationFramework.Tests.csproj
echo.
echo   Data loader - check a CSV or a folder of scenarios-*.csv files:
echo     dotnet run --project PricingValidationFramework.DataLoader -- validate --requests ^<csv-or-folder^> --request-time now
echo.
echo   Seed first baselines into [Xml].[Response] for scenarios without one. Copy
echo   data\import\examples\local-settings.example.json to data\import\local-settings.json,
echo   fill it in, then:
echo     dotnet run --project PricingValidationFramework.DataLoader -- seed --settings data\import\local-settings.json --max-parallel 1
echo.
echo   VS Code: open the "%targetdir%" folder; Run and Debug lists
echo   1. validate, 2. import and 3. seed, all using that settings file.
echo.
echo   Radar routing lives in config\radar\mappings.json and config\radar\XPathProfiles.
echo   Radar compares only: run seed before Radar for newly loaded scenarios.
echo.
echo None of these need admin rights. See README.md for the Radar and ICE flows.
echo Database: the code uses [Xml].[Request] and [Xml].[Response] with the row_* audit columns.
echo Set DatabaseSettings__AuditUser to choose the name written to row_createdby/row_modifiedby.
echo.
call :pauseifdoubleclicked
exit /b 0

:damaged
del "%zipfile%" >nul 2>nul
echo.
echo This copy of the script is damaged: the embedded archive does not match its checksum.
echo Expected %expectedhash%
echo Got      %actualhash%
echo Nothing was extracted. Copy the script again - all parts, in order, each in full -
echo or move the file itself rather than its text.
goto :fail

:fail
call :pauseifdoubleclicked
exit /b 1

rem Keep the window open when the script was double-clicked from Explorer.
:pauseifdoubleclicked
echo %cmdcmdline% | findstr /i /c:"%scriptname%" >nul
if not errorlevel 1 pause
exit /b 0
