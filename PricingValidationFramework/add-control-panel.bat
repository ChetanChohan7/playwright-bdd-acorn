@echo off
setlocal

rem ===========================================================================
rem add-control-panel.bat
rem
rem Adds the NEW files of the control-panel branch to an existing
rem PricingValidationFramework folder: the PricingValidationFramework.ControlPanel
rem project (a local web page with a button per step: choose CSV, import,
rem seed, Radar compare, ICE check, set status), the set-status update
rem (Core ScenarioStatusUpdater.cs, DataLoader SetStatusCommand.cs) and
rem azure-pipelines-set-status.yml.
rem
rem It changes NO existing file. Make these edits by hand afterwards (they are
rem printed at the end):
rem   - DataLoader Program.cs: route "set-status" (needed for step 6)
rem   - PricingValidationFramework.slnx: add the ControlPanel project
rem   - .vscode launch.json / tasks.json: the "Control panel" entries
rem Test files are not included: they need edits to the test project too.
rem
rem Needs no admin rights; writes only to the folder and %%TEMP%%.
rem Usage:  add-control-panel.bat [project-folder] [/force]
rem         project-folder: the one holding PricingValidationFramework.slnx
rem                         (default: the folder this script is in)
rem         /force: replace files that already exist (they are backed up first)
rem ===========================================================================

set "scriptname=%~nx0"
cd /d "%~dp0"

set "targetdir="
set "force="
:parseargs
if "%~1"=="" goto :argsdone
if /i "%~1"=="/force" (set "force=1") else (set "targetdir=%~1")
shift
goto :parseargs
:argsdone
if not defined targetdir set "targetdir=%CD%"
for %%I in ("%targetdir%") do set "targetdir=%%~fI"
if "%targetdir:~-1%"=="\" set "targetdir=%targetdir:~0,-1%"

if not exist "%targetdir%\PricingValidationFramework.slnx" (
    echo "%targetdir%" does not contain PricingValidationFramework.slnx.
    echo Put this script in your PricingValidationFramework folder, or pass that folder:
    echo   add-control-panel.bat C:\path\to\PricingValidationFramework
    goto :fail
)
echo Project folder: "%targetdir%"

rem 1. These files must not exist yet (unless /force).
set "clash="
echo Checking none of the new files exist yet...
if exist "%targetdir%\PricingValidationFramework.ControlPanel\ControlPanelOptions.cs" (echo   PricingValidationFramework.ControlPanel\ControlPanelOptions.cs& set "clash=1")
if exist "%targetdir%\PricingValidationFramework.ControlPanel\PricingValidationFramework.ControlPanel.csproj" (echo   PricingValidationFramework.ControlPanel\PricingValidationFramework.ControlPanel.csproj& set "clash=1")
if exist "%targetdir%\PricingValidationFramework.ControlPanel\Program.cs" (echo   PricingValidationFramework.ControlPanel\Program.cs& set "clash=1")
if exist "%targetdir%\PricingValidationFramework.ControlPanel\Steps\IStepRunner.cs" (echo   PricingValidationFramework.ControlPanel\Steps\IStepRunner.cs& set "clash=1")
if exist "%targetdir%\PricingValidationFramework.ControlPanel\Steps\LocalCommandBuilder.cs" (echo   PricingValidationFramework.ControlPanel\Steps\LocalCommandBuilder.cs& set "clash=1")
if exist "%targetdir%\PricingValidationFramework.ControlPanel\Steps\LocalStepRunner.cs" (echo   PricingValidationFramework.ControlPanel\Steps\LocalStepRunner.cs& set "clash=1")
if exist "%targetdir%\PricingValidationFramework.ControlPanel\Steps\StepInputs.cs" (echo   PricingValidationFramework.ControlPanel\Steps\StepInputs.cs& set "clash=1")
if exist "%targetdir%\PricingValidationFramework.ControlPanel\Steps\StepJob.cs" (echo   PricingValidationFramework.ControlPanel\Steps\StepJob.cs& set "clash=1")
if exist "%targetdir%\PricingValidationFramework.ControlPanel\Steps\StepRequests.cs" (echo   PricingValidationFramework.ControlPanel\Steps\StepRequests.cs& set "clash=1")
if exist "%targetdir%\PricingValidationFramework.ControlPanel\Steps\StepResultReader.cs" (echo   PricingValidationFramework.ControlPanel\Steps\StepResultReader.cs& set "clash=1")
if exist "%targetdir%\PricingValidationFramework.ControlPanel\appsettings.json" (echo   PricingValidationFramework.ControlPanel\appsettings.json& set "clash=1")
if exist "%targetdir%\PricingValidationFramework.ControlPanel\ui\app.js" (echo   PricingValidationFramework.ControlPanel\ui\app.js& set "clash=1")
if exist "%targetdir%\PricingValidationFramework.ControlPanel\ui\index.html" (echo   PricingValidationFramework.ControlPanel\ui\index.html& set "clash=1")
if exist "%targetdir%\PricingValidationFramework.ControlPanel\ui\styles.css" (echo   PricingValidationFramework.ControlPanel\ui\styles.css& set "clash=1")
if exist "%targetdir%\PricingValidationFramework.Core\Database\ScenarioStatusUpdater.cs" (echo   PricingValidationFramework.Core\Database\ScenarioStatusUpdater.cs& set "clash=1")
if exist "%targetdir%\PricingValidationFramework.DataLoader\SetStatusCommand.cs" (echo   PricingValidationFramework.DataLoader\SetStatusCommand.cs& set "clash=1")
if exist "%targetdir%\azure-pipelines-set-status.yml" (echo   azure-pipelines-set-status.yml& set "clash=1")
if defined clash (
    echo.
    if not defined force (
        echo The files above already exist, so nothing was changed.
        echo Run again with /force to replace them - each is backed up first.
        goto :fail
    )
    echo /force given - replacing them. The current versions go to the backup folder.
)

set "work=%TEMP%\pvf-controlpanel-%RANDOM%%RANDOM%"
mkdir "%work%"
set "b64file=%work%\payload.b64"
set "zipfile=%work%\payload.zip"
set "stage=%work%\files"

rem 2. Decode and verify the embedded files.
