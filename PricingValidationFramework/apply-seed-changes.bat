@echo off
setlocal

rem ===========================================================================
rem apply-seed-changes.bat
rem
rem Updates an EXISTING PricingValidationFramework folder from commit 2dd63e1
rem (the folder create-pricing-validation-framework.bat made) with the seed
rem changes only:
rem   - DataLoader "seed" command: first [Xml].[Response] baselines for every
rem     scenario that has none (Core BaselineSeeder, RadarSettingsValidator)
rem   - Radar compares only: a missing baseline is an ERROR; baseline-only
rem     mode removed
rem   - data-loader pipeline: "Seed baselines" stage replaces "Create baselines"
rem   - VS Code launch/tasks files, local-settings.example.json, tests, docs
rem It does NOT include the ICE-stage changes to the Radar pipeline.
rem
rem Safe to run:
rem   - checks the folder is the 2dd63e1 version before changing anything
rem     (line endings are ignored, so a git checkout with CRLF is fine)
rem   - backs up every file it replaces or deletes to _backup-before-seed
rem   - keeps your own .vscode\launch.json / tasks.json if you have them, and
rem     writes the new ones next to them as launch.seed.json / tasks.seed.json
rem   - needs no admin rights; writes only to the folder and %%TEMP%%
rem
rem Usage:  apply-seed-changes.bat [project-folder] [/force]
rem         project-folder: the one holding PricingValidationFramework.slnx
rem                         (default: the folder this script is in)
rem         /force: apply even if some files differ from 2dd63e1 (they are
rem                 still backed up first)
rem ===========================================================================

set "scriptname=%~nx0"
cd /d "%~dp0"

set "targetdir="
set "force="
:parseargs
if "%~1"=="" goto :argsdone
if /i "%~1"=="/force" (set "force=1") else (set "targetdir=%~1")
shift
goto :parseargs
:argsdone
if not defined targetdir set "targetdir=%CD%"
for %%I in ("%targetdir%") do set "targetdir=%%~fI"
if "%targetdir:~-1%"=="\" set "targetdir=%targetdir:~0,-1%"

if not exist "%targetdir%\PricingValidationFramework.slnx" (
    echo "%targetdir%" does not contain PricingValidationFramework.slnx.
    echo Put this script in your PricingValidationFramework folder, or pass that folder:
    echo   apply-seed-changes.bat C:\path\to\PricingValidationFramework
    goto :fail
)
echo Project folder: "%targetdir%"

set "work=%TEMP%\pvf-seed-%RANDOM%%RANDOM%"
mkdir "%work%"
set "b64file=%work%\payload.b64"
set "zipfile=%work%\payload.zip"
set "stage=%work%\files"
set "manifest=%work%\manifest.txt"
set "checkfile=%work%\check.txt"
set "listfile=%work%\files.txt"

