echo.

:nextsteps
echo Next steps, from "%targetdir%":
echo.
echo   1. Copy data\import\examples\local-settings.example.json to data\import\local-settings.json
echo      and fill in the connection string and the Radar endpoint(s) you use. Git ignores it.
echo   2. Seed baselines for scenarios that have none:
echo        dotnet run --project PricingValidationFramework.DataLoader -- seed --settings data\import\local-settings.json --max-parallel 1
echo      or in VS Code, Run and Debug: "3. DataLoader: seed baselines into [Xml].[Response]".
echo   3. Then run Radar. A scenario without a baseline is now an ERROR (MissingBaseline).
echo.
echo   Seed needs a route in config\radar\mappings.json for each scenario's product and scheme.
echo   Pipeline: the data-loader parameter createBaselines is now seedBaselines.
echo.
call :pauseifdoubleclicked
exit /b 0

:backup
if not exist "%targetdir%\%~1" exit /b 0
for %%D in ("%backupdir%\%~1") do if not exist "%%~dpD" mkdir "%%~dpD"
copy /y "%targetdir%\%~1" "%backupdir%\%~1" >nul
exit /b 0

:damaged
echo.
echo This copy of the script is damaged: the embedded archive does not match its checksum.
echo Expected %expectedhash%
echo Got      %actualhash%
echo Nothing was changed. Copy the script again - all parts, in order, each in full.
goto :cleanupfail

:cleanup
if exist "%work%" rmdir /s /q "%work%"
exit /b 0

:cleanupfail
call :cleanup
:fail
call :pauseifdoubleclicked
exit /b 1

rem Keep the window open when the script was double-clicked from Explorer.
:pauseifdoubleclicked
echo %cmdcmdline% | findstr /i /c:"%scriptname%" >nul
if not errorlevel 1 pause
exit /b 0
