set "expectedhash=CF4A92F7D300F7512CBF94213E0A473C7A0FBA76B8C873F0F1D8D1BC33C8BDEB"
set "actualhash="
for /f "skip=1 delims=" %%H in ('certutil -hashfile "%zipfile%" SHA256 2^>nul') do if not defined actualhash set "actualhash=%%H"
if defined actualhash if not "%actualhash:CertUtil=%"=="%actualhash%" set "actualhash="
if not defined actualhash for /f "delims=" %%H in ('powershell -NoProfile -Command "(Get-FileHash -Algorithm SHA256 -LiteralPath $env:zipfile).Hash"') do set "actualhash=%%H"
if defined actualhash set "actualhash=%actualhash: =%"
if /i not "%actualhash%"=="%expectedhash%" goto :damaged
