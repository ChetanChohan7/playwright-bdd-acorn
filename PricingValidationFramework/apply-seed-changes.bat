    echo You already had .vscode\launch.json and/or tasks.json, so they were kept. The new
    echo debug configurations are in .vscode\launch.seed.json and tasks.seed.json - copy
    echo the "3. DataLoader: seed" entry and the "build DataLoader" task into yours.
)
