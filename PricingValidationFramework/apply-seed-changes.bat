rem Keep your own VS Code files; put the new ones beside them.
set "vscodenote="
if exist "%targetdir%\.vscode\launch.json" (
    move /y "%stage%\.vscode\launch.json" "%stage%\.vscode\launch.seed.json" >nul
    set "vscodenote=1"
)
if exist "%targetdir%\.vscode\tasks.json" (
    move /y "%stage%\.vscode\tasks.json" "%stage%\.vscode\tasks.seed.json" >nul
    set "vscodenote=1"
)

rem 4. Apply.
echo Applying the seed changes...
xcopy "%stage%" "%targetdir%" /e /i /y /q >nul
if errorlevel 1 (
    echo Copying the files failed. Restore from "%backupdir%" if anything looks wrong.
    goto :cleanupfail
)
if exist "%targetdir%\PricingValidationFramework.Tests\System\Radar\RadarBaselineOnlySettingTests.cs" del "%targetdir%\PricingValidationFramework.Tests\System\Radar\RadarBaselineOnlySettingTests.cs"
