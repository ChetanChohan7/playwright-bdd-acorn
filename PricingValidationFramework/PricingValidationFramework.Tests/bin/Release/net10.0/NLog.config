<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <targets>
    <target xsi:type="File"
            name="iceFile"
            fileName="${basedir}/TestResults/Logs/Ice_${gdc:item=BuildId}.log"
            layout="${longdate} [${level:uppercase=true}] ${message} ${exception:format=tostring}" />
    <target xsi:type="File"
            name="radarFile"
            fileName="${basedir}/TestResults/Logs/Radar_${gdc:item=RadarBuildId}.log"
            layout="${longdate} [${level:uppercase=true}] ${message} ${exception:format=tostring}" />
  </targets>
  <rules>
    <logger name="PricingValidationFramework.Core.Logging.RadarTestRunLogger" minlevel="Info" writeTo="radarFile" final="true" />
    <logger name="PricingValidationFramework.Core.ExternalAPIAccess.ApiClients.RadarApiClient" minlevel="Info" writeTo="radarFile" final="true" />
    <logger name="PricingValidationFramework.Core.Logging.IceTestRunLogger" minlevel="Info" writeTo="iceFile" final="true" />
    <logger name="PricingValidationFramework.Core.ExternalAPIAccess.ApiClients.IceApiClient" minlevel="Info" writeTo="iceFile" final="true" />
  </rules>
</nlog>