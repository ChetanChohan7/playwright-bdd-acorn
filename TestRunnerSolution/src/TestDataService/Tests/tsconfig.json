{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "UiTests/**/*.ts",
    "ApiTests/**/*.ts",
    "TestSupport/**/*.ts",
    "playwright.config.ts"
  ]
}
