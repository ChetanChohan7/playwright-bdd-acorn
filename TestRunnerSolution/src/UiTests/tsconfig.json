{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node", "@playwright/test"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
  "include": [
    "features/**/*.ts",
    "steps/**/*.ts",
    "api/**/*.ts",
    "clients/**/*.ts",
    "contracts/**/*.ts",
    "fixtures/**/*.ts",
    "support/**/*.ts",
    "utils/**/*.ts",
    "pages/**/*.ts",
    "db/**/*.ts",
    "playwright.config.ts"
  ]
}
